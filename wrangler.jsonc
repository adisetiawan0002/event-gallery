{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "event-gallery",

  "main": "./src/index.js",

  "compatibility_date": "2026-08-24",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "event-gallery-media"
    }
  ]
}